<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.crudjavafx.FXPrincipalController">
   <children>
      <Pane layoutX="20.0" layoutY="20.0" prefHeight="320.0" prefWidth="270.0" style="-fx-border-color: #bbbbbb;">
         <children>
            <Label layoutX="15.0" layoutY="25.0" text="ID:" />
            <Label layoutX="15.0" layoutY="70.0" text="Nombre:" />
            <Label layoutX="15.0" layoutY="115.0" text="Apellidos:" />
            <Label layoutX="15.0" layoutY="160.0" text="Sexo:" />
            <TextField fx:id="txtId" editable="false" layoutX="95.0" layoutY="21.0" />
            <TextField fx:id="txtNombre" layoutX="95.0" layoutY="66.0" />
            <TextField fx:id="txtApellidos" layoutX="95.0" layoutY="111.0" />
            <ComboBox fx:id="cbsexo" layoutX="95.0" layoutY="156.0" prefWidth="150.0" />
            <Button fx:id="btnGuardar" layoutX="15.0" layoutY="225.0" mnemonicParsing="false" onAction="#guardar" text="Guardar" />
            <Button fx:id="btnEditar" layoutX="95.0" layoutY="225.0" mnemonicParsing="false" onAction="#editar" text="Editar" />
            <Button fx:id="btnBorrar" layoutX="170.0" layoutY="225.0" mnemonicParsing="false" onAction="#borrar" text="Borrar" />
            <Button fx:id="btnLimpiar" layoutX="15.0" layoutY="270.0" mnemonicParsing="false" onAction="#limpiar" text="Limpiar" />
         </children>
      </Pane>
      <TableView fx:id="tvUsuarios" layoutX="310.0" layoutY="20.0" prefHeight="460.0" prefWidth="470.0" />
   </children>
</AnchorPane>
